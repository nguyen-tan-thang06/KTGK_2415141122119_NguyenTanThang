<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTieuDe_119"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="QUẢN LÝ CHI TIÊU CÁ NHÂN"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên khoản chi (*):"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtTenKhoanChi_119"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập tên khoản chi (VD: Mua giáo trình 119)"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Số tiền (VNĐ) (*):"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtSoTien_119"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập số tiền > 0 (VD: 119000)"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Ghi chú:"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtMoTaKhoanChi_119"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập ghi chú khoản chi"
            android:inputType="text" />

        <CheckBox
            android:id="@+id/chkDaThanhToan_119"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="Đã thanh toán" />

        <Button
            android:id="@+id/btnThemKhoanChi_119"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Thêm khoản chi" />

        <Button
            android:id="@+id/btnXemChiTiet_119"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Xem chi tiết khoản chi" />

    </LinearLayout>
</ScrollView>