<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="QUẢN LÝ CHI TIÊU CÁ NHÂN"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/edtTenKhoanChi_119"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập tên khoản chi (*)" />

    <EditText
        android:id="@+id/edtSoTien_119"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Nhập số tiền > 0 (*)"
        android:inputType="numberDecimal" />

    <EditText
        android:id="@+id/edtGhiChu_119"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Nhập ghi chú" />

    <CheckBox
        android:id="@+id/chkDaThanhToan_119"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:checked="true"
        android:text="Đã thanh toán" />

    <Button
        android:id="@+id/btnThemKhoanChi_119"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Thêm khoản chi" />

    <Button
        android:id="@+id/btnXemChiTiet_119"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Xem chi tiết khoản chi" />

</LinearLayout>